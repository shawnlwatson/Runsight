# Copy this file to .env and supply the group's private MongoDB connection string.
# Keep .env out of Git.
MONGODB_URI=

# Runsight Assistant (Vercel AI Gateway). Locally, create a key with `vercel ai-gateway api-keys create`
# or in the Vercel dashboard. On a Vercel deployment, leave it unset: the deployment's OIDC token is used.
AI_GATEWAY_API_KEY=
# Optional: any tool-capable model id from https://ai-gateway.vercel.sh/v1/models
AI_GATEWAY_MODEL=
