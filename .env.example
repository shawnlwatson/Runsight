# Copy this file to .env and supply the group's private MongoDB connection string.
# Keep .env out of Git.
MONGODB_URI=

# Runsight Assistant. Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: use Vercel AI Gateway instead (leave GEMINI_API_KEY empty). On a Vercel deployment the
# deployment's OIDC token is used automatically, so this key is only needed locally.
AI_GATEWAY_API_KEY=
# Optional: model id for whichever provider is active (defaults: gemini-2.5-flash, anthropic/claude-haiku-5.5)
AI_MODEL=
